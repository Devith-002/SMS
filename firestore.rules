rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function uref() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isAdmin() { return signed() && (request.auth.token.email in ['admin@example.com'] || (exists(uref()) && get(uref()).data.role == 'admin')); }
    function isMgmt() { return isAdmin() || (signed() && exists(uref()) && get(uref()).data.role == 'management'); }
    function isStaff() { return isAdmin() || (signed() && exists(uref())); }

    match /users/{u} {
      allow get: if (signed() && request.auth.uid == u) || isMgmt();
      allow list: if isMgmt();
      allow write: if isAdmin();
    }
    /* សិស្សមើលតាមអត្តលេខ (get ប៉ុណ្ណោះ គ្មាន list) ហើយមានតែទិន្នន័យមិនរសើប */
    match /students/{id} { allow get: if true; allow list: if isStaff(); allow write: if isMgmt(); }
    match /photos/{id}   { allow get: if true; allow write: if isMgmt(); }
    match /classes/{id}  { allow get: if true; allow list: if isStaff(); allow write: if isMgmt(); }
    /* កាលវិភាគ: ទាំងអស់មើលបាន ប៉ុន្តែមានតែ Admin/គណៈគ្រប់គ្រងកែបាន */
    match /timetable/{d} { allow get: if true; allow write: if isMgmt(); }
    match /settings/{d}  { allow get: if true; allow write: if isAdmin(); }
  }
}
